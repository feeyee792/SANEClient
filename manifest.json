{
	"name": "SANE扫描客户端",
	"appid": "__UNI__340AAE7",
	"description": "SANE 网络扫描客户端（FEEYEE & 豆包 协作开发）",
	"versionName": "1.0.0",
	"versionCode": "100",
	"transformPx": false,
	"app-plus": {
		"usingComponents": true,
		"nvueStyleCompiler": "uni-app",
		"compilerVersion": 3,
		"splashscreen": {
			"alwaysShowBeforeRender": true,
			"waiting": true,
			"autoclose": true,
			"delay": 0,
			"image": "static/splash.png",
			"backgroundColor": "#FAF9F6"
		},
		"modules": {},
		"distribute": {
			"android": {
				"permissions": [
					"<uses-permission android:name=\"android.permission.INTERNET\"/>",
					"<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>",
					"<uses-permission android:name=\"android.permission.WRITE_EXTERNAL_STORAGE\"/>"
				],
				"minSdkVersion": 24,
				"targetSdkVersion": 33,
				"abiFilters": [
					"armeabi-v7a",
					"arm64-v8a"
				]
			},
			"ios": {},
			"sdkConfigs": {}
		}
	},
	"uni-app-x": {},
	"web": {
		"router": {
			"mode": ""
		}
	},
	"app-android": {
		"distribute": {
			"icons": {
				"mdpi": "static/icon/icon-48.png",
				"hdpi": "static/icon/icon-72.png",
				"xhdpi": "static/icon/icon-96.png",
				"xxhdpi": "static/icon/icon-144.png",
				"xxxhdpi": "static/icon/icon-192.png"
			},
			"abiFilters": [
				"armeabi-v7a",
				"arm64-v8a",
				"x86",
				"x86_64"
			],
			"splashScreens": {
				"default": {
					"xhdpi": ""
				}
			}
		}
	}
}
