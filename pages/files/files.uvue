	}

	.preview-actions {
		margin-top: 24rpx;
		width: 100%;
		display: flex;
		flex-direction: row;
	}

	.preview-btn {
		flex: 1;
		margin-left: 10rpx;
		margin-right: 10rpx;
		background-color: #0FA3A3;
		color: #FFFFFF;
		font-size: 30rpx;
		border-radius: 10px;
		border-width: 0;
	}

	.preview-btn.ghost {
		background-color: #FFFFFF;
