<template>
	<view class="page">
		<view class="header">
			<text class="header-title">文件管理</text>
			<text class="header-count">{{fileCount}} 个文件</text>
		</view>

		<!-- 搜索框 -->
		<view class="search-bar">
			<input class="search-input" v-model="keyword" placeholder="搜索文件名…" />
		</view>

		<!-- 回收长列表（分组头 + 文件项统一高度 90px） -->
		<uni-recycle-view v-if="flatItems.length > 0" :itemHeight="90" :list="flatItems" style="flex: 1;">
			<template v-slot:default="{layoutItems, items}">
				<uni-recycle-item v-for="(item, index) in (items as FlatFileItem[])" :key="(layoutItems as LayoutItem[])[index].id" :offset="(layoutItems as LayoutItem[])[index].offset">
					<!-- 分组头 -->
					<view v-if="item.type == 0" class="group-header" @click="onGroupToggle(item)">
						<view class="group-left">
							<text class="group-arrow">{{isCollapsed(item.dateKey) ? '▶' : '▼'}}</text>
							<text class="group-date">{{item.dateText}}</text>
						</view>
						<text class="group-count">{{item.count}} 个文件</text>
					</view>
					<!-- 文件项 -->
					<view v-else class="file-card" @click="onFileClick(item)">
						<image v-if="!item.isPdf" class="thumb" :src="item.filePath" mode="aspectFill"></image>
						<view v-else class="thumb pdf-thumb">
							<text class="pdf-text">PDF</text>
						</view>
						<view class="file-info">
							<text class="file-name">{{item.fileName}}</text>
							<text class="file-size">{{item.fileSizeText}}</text>
						</view>
						<text class="file-tag">{{item.isPdf ? 'PDF' : '图片'}}</text>
					</view>
				</uni-recycle-item>
			</template>
		</uni-recycle-view>

		<!-- 空态 -->
		<view v-else class="empty">
			<text class="empty-title">{{keyword == '' ? '还没有扫描文件' : '没有匹配的文件'}}</text>
			<text class="empty-sub">{{keyword == '' ? '去扫描页扫一张试试吧' : '换个关键词试试'}}</text>
		</view>

		<!-- 预览弹层 -->
		<view v-if="showPreview" class="preview-mask" @click="closePreview">
			<view class="preview-box" @click.stop>
				<image v-if="!previewItem.isPdf" class="preview-img" :src="previewItem.path" mode="aspectFit" @click="openSystem"></image>
				<view v-else class="preview-pdf" @click="openSystem">
					<text class="preview-pdf-text">PDF 文件（{{previewItem.name}}）</text>
					<text class="preview-pdf-sub">点击调用系统查看器打开</text>
				</view>
				<text class="preview-name">{{previewItem.name}}</text>
				<view class="preview-actions">
					<button class="preview-btn" @click="openSystem">{{previewItem.isPdf ? '系统打开' : '放大查看'}}</button>
					<button class="preview-btn" @click="closePreview">关闭</button>
				</view>
				<view class="preview-actions">
					<button class="preview-btn ghost" @click="onShare">分享</button>
					<button class="preview-btn ghost" @click="onPrint">打印</button>
					<button class="preview-btn ghost" @click="onExport">导出到手机</button>
				</view>
			</view>
		</view>
	</view>
</template>

<script lang="uts">
	import { store } from '../../common/sane/store'
	import { ScanFileInfo } from '../../common/sane/fileutil'
	import { FlatFileItem, buildFlatItems } from '../../common/sane/filegroup'
	import { shareFile, printImage, exportFile } from '../../common/sane/share'
	import { LayoutItem } from '@/uni_modules/uni-recycle-view/common/types.uts'

	export default {
		data() {
			return {
				keyword: '',
				fileCount: 0,
				collapsed: [] as Array<string>,
				flatItems: [] as Array<FlatFileItem>,
				showPreview: false,
				previewItem: new ScanFileInfo()
			}
		},
		watch: {
			keyword(): void {
				this.rebuild()
			}
		},
		onShow() {
			store.refreshFiles()
			this.rebuild()
		},
		methods: {
			rebuild(): void {
				this.fileCount = store.files.length
				this.flatItems = buildFlatItems(store.files, this.keyword, this.collapsed)
			},
			isCollapsed(key: string): boolean {
				return this.collapsed.indexOf(key) >= 0
			},
			onGroupToggle(item: FlatFileItem): void {
				const key: string = item.dateKey
				const idx: number = this.collapsed.indexOf(key)
				if (idx >= 0) {
					this.collapsed.splice(idx, 1)
				} else {
					this.collapsed.push(key)
				}
				this.rebuild()
			},
			onFileClick(item: FlatFileItem): void {
				if (item.raw != null) {
					this.previewItem = item.raw
					this.showPreview = true
				}
			},
			closePreview(): void {
				this.showPreview = false
			},
			openSystem(): void {
				const p = this.previewItem
				if (p.path == '') {
					return
				}
				if (p.isPdf) {
					uni.openDocument({
						filePath: p.path,
						fileType: 'pdf',
						fail: (err: any | null) => {
							uni.showToast({ title: '系统打开失败', icon: 'none' })
						}
					})
				} else {
					uni.previewImage({
						urls: [p.path],
						current: 0,
						fail: (err: any | null) => {
							uni.showToast({ title: '预览失败', icon: 'none' })
						}
					})
				}
			},
			onShare(): void {
				const p = this.previewItem
				if (p.path == '') {
					return
				}
				shareFile(p.path, p.isPdf)
			},
			onPrint(): void {
				const p = this.previewItem
				if (p.path == '') {
					return
				}
				if (p.isPdf) {
					uni.showToast({ title: 'PDF 请先系统打开，再在查看器中打印', icon: 'none' })
					return
				}
				printImage(p.path, p.name)
			},
			onExport(): void {
				const p = this.previewItem
				if (p.path == '') {
					return
				}
				exportFile(p.path, p.name, p.isPdf)
			}
		}
	}
</script>

<style>
