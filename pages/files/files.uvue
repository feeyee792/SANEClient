		color: #C0392B;
	}

	.file-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		margin-left: 20rpx;
	}

	.file-name {
		font-size: 28rpx;
		color: #2B2B2B;
	}

	.file-size {
		font-size: 22rpx;
		color: #8A8A8A;
		margin-top: 8rpx;
	}

	.file-tag {
		font-size: 20rpx;
		color: #0FA3A3;
		background-color: #E8F5F5;
		padding: 4rpx 14rpx;
