		background-color: rgba(0, 0, 0, 0.7);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 100;
	}

	.preview-box {
		width: 85%;
		background-color: #FFFFFF;
		border-radius: 16px;
		padding: 30rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.preview-img {
		width: 100%;
		height: 800rpx;
	}

	.preview-pdf {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 100rpx 0;
	}

	.preview-pdf-text {
		font-size: 28rpx;
		color: #2B2B2B;
	}

	.preview-pdf-sub {
		font-size: 24rpx;
